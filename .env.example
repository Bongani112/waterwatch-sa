# Database (docker-compose uses these to create the PostGIS container)
POSTGRES_USER=waterwatch
POSTGRES_PASSWORD=waterwatch
POSTGRES_DB=waterwatch
DATABASE_URL=postgresql+psycopg://waterwatch:waterwatch@localhost:5432/waterwatch

# Auth - generate a long random value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Uploads (stored outside the public web root)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# First administrator, created by `python -m app.seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin

# Frontend: leave empty to use the Vite dev proxy / nginx /api proxy
VITE_API_URL=
